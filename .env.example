# Choose one provider.

# Option A: TogetherAI
TOGETHERAI_API_KEY=replace-me
TOGETHER_API_KEY=replace-me              # Same value — promptfoo rubric reads this var name
TOGETHER_MODEL_CHAT=zai-org/GLM-5.1

# Option B: OpenAI
# OPENAI_API_KEY=replace-me
# CREWAI_MODEL=openai/gpt-4o-mini

# Optional: tell promptfoo which Python has crewai installed.
# PROMPTFOO_PYTHON=.venv/bin/python

# Optional: keep local run state inside this repo.
PROMPTFOO_CONFIG_DIR=.promptfoo
CREWAI_TRACING_ENABLED=false

# The llm-rubric assertion uses OpenAI by default.
# If you run the agent with TogetherAI but want rubric grading,
# uncomment OPENAI_API_KEY below or set PROMPTFOO_RUBRIC_PROVIDER.
# OPENAI_API_KEY=replace-me
# PROMPTFOO_RUBRIC_PROVIDER=openai:gpt-4o-mini
