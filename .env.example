# Required: OpenAI API key (used by both the CrewAI agent and llm-rubric assertions).
OPENAI_API_KEY=replace-me

# Optional: override the default CrewAI model (default: openai/gpt-4o-mini).
# CREWAI_MODEL=openai/gpt-4o

# Optional: tell promptfoo which Python has crewai installed.
# PROMPTFOO_PYTHON=.venv/bin/python

# Optional: keep local run state inside this repo.
PROMPTFOO_CONFIG_DIR=.promptfoo
CREWAI_TRACING_ENABLED=false
